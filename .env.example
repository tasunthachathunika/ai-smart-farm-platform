# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DB_USER=goviya
DB_PASSWORD=ChooseAStrongPassword123
DB_NAME=goviya_plus
POSTGRES_USER=goviya
POSTGRES_PASSWORD=ChooseAStrongPassword123
POSTGRES_DB=goviya_plus
# In Docker compose: db:5432; for host development: localhost:5432
DATABASE_URL=postgres://goviya:ChooseAStrongPassword123@db:5432/goviya_plus

# Security & Authentication
# JWT Secret for cookie authentication (minimum 32 characters)
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-example
JWT_EXPIRES_IN=7d

# GPS Encryption Key (AES-256-GCM requires 32-byte / 64-hex-character key)
GPS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client / CORS
CORS_ORIGIN=http://localhost:3000

# API Documentation (Swagger UI at /api/docs)
# Defaults to true in development, false in production unless SWAGGER_ENABLED=true
SWAGGER_ENABLED=true
