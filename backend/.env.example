# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://goviya_user:goviya_password@localhost:5432/goviya_plus_db

# Security & Authentication
# JWT Secret for cookie authentication (minimum 32 characters)
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-example
JWT_EXPIRES_IN=7d

# GPS Encryption Key (AES-256-GCM requires 32-byte / 64-hex-character key)
GPS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Client / CORS
CORS_ORIGIN=http://localhost:3000
