// Goviya Plus — Database Schema (DBML)
// AI Smart Farm Records & Crop Advisory Platform

Project goviya_plus {
  database_type: 'PostgreSQL'
  Note: 'Database schema for Goviya Plus platform supporting farmers, extension officers, and administrators with strict role boundaries, GPS privacy, and immutable audit logs.'
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum user_role {
  farmer
  officer
  admin
}

enum share_scope {
  view_only
  advisory
  full
}

enum cycle_status {
  planned
  active
  completed
  abandoned
}

enum log_type {
  general
  observation
  irrigation
  fertilizer
  pest_control
  disease
  weather
}

enum input_type {
  fertilizer
  pesticide
  seed
  organic_matter
  other
}

enum audit_action {
  create
  read
  update
  delete
  login
  logout
  share_grant
  share_revoke
}

// ----------------------------------------------------
// TABLES
// ----------------------------------------------------

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null, note: 'Argon2id password hash']
  full_name varchar(255) [not null]
  phone varchar(50)
  role user_role [not null, default: 'farmer']
  is_verified boolean [not null, default: false, note: 'Required for agricultural officers']
  failed_login_attempts int [not null, default: 0]
  locked_until timestamptz [note: 'Lockout timestamp after repeated failed logins']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    email [name: 'idx_users_email']
    role [name: 'idx_users_role']
  }
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token_hash varchar(255) [unique, not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    token_hash [name: 'idx_refresh_tokens_hash']
    user_id [name: 'idx_refresh_tokens_user_id']
  }
}

Table plots {
  id uuid [pk, default: `gen_random_uuid()`]
  farmer_id uuid [not null, ref: > users.id, note: 'Plot owner']
  name varchar(255) [not null]
  district varchar(100) [not null, note: 'Blurred district-level location visible to officers']
  encrypted_gps text [not null, note: 'AES-256-GCM encrypted coordinates (ciphertext)']
  gps_iv varchar(64) [not null, note: 'Initialization vector for AES-256-GCM']
  gps_auth_tag varchar(64) [not null, note: 'Authentication tag for AES-256-GCM']
  area_ha numeric(10, 4) [not null, note: 'CHECK: area_ha > 0']
  soil_type varchar(100)
  irrigation_source varchar(100)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    farmer_id [name: 'idx_plots_farmer_id']
    district [name: 'idx_plots_district']
  }
}

Table shared_plots {
  id uuid [pk, default: `gen_random_uuid()`]
  plot_id uuid [not null, ref: > plots.id]
  officer_id uuid [not null, ref: > users.id]
  scope share_scope [not null, default: 'view_only']
  granted_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  revoked_at timestamptz

  indexes {
    (plot_id, officer_id) [name: 'idx_shared_plots_active_unique', note: 'Partial unique index WHERE revoked_at IS NULL']
    officer_id [name: 'idx_shared_plots_officer_id']
  }
}

Table crop_cycles {
  id uuid [pk, default: `gen_random_uuid()`]
  plot_id uuid [not null, ref: > plots.id]
  crop_name varchar(100) [not null]
  variety varchar(100)
  start_date date [not null]
  end_date date [note: 'CHECK: end_date IS NULL OR end_date >= start_date']
  status cycle_status [not null, default: 'planned']
  estimated_yield_kg numeric(10, 2)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    plot_id [name: 'idx_crop_cycles_plot_id']
    status [name: 'idx_crop_cycles_status']
  }
}

Table farm_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  cycle_id uuid [not null, ref: > crop_cycles.id]
  log_type log_type [not null, default: 'general']
  log_date date [not null, default: `current_date`]
  notes text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    cycle_id [name: 'idx_farm_logs_cycle_id']
    log_date [name: 'idx_farm_logs_date']
  }
}

Table inputs {
  id uuid [pk, default: `gen_random_uuid()`]
  cycle_id uuid [not null, ref: > crop_cycles.id]
  input_type input_type [not null, default: 'other']
  name varchar(255) [not null]
  quantity numeric(10, 2) [not null, note: 'CHECK: quantity > 0']
  unit varchar(50) [not null]
  application_date date [not null]
  cost numeric(12, 2)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    cycle_id [name: 'idx_inputs_cycle_id']
  }
}

Table harvests {
  id uuid [pk, default: `gen_random_uuid()`]
  cycle_id uuid [not null, ref: > crop_cycles.id]
  harvest_date date [not null]
  quantity numeric(10, 2) [not null, note: 'CHECK: quantity > 0']
  unit varchar(50) [not null]
  quality_grade varchar(50)
  revenue numeric(12, 2)
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    cycle_id [name: 'idx_harvests_cycle_id']
    harvest_date [name: 'idx_harvests_date']
  }
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [ref: > users.id, note: 'Nullable if anonymous or system action']
  action audit_action [not null]
  entity_type varchar(100) [not null]
  entity_id uuid
  metadata jsonb
  ip_address varchar(45)
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  note: 'Immutable / append-only table. Disallows UPDATE and DELETE operations.'

  indexes {
    user_id [name: 'idx_audit_logs_user_id']
    created_at [name: 'idx_audit_logs_created_at']
    entity_type [name: 'idx_audit_logs_entity']
  }
}
